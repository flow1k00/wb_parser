# Скопируй этот файл в .env и заполни своими значениями.
# Файл .env перечислен в .gitignore и в репозиторий не попадёт.

# ID Google-таблицы — берётся из её URL, между /d/ и /edit
WB_SPREADSHEET_ID=

# Путь к JSON-ключу сервисного аккаунта Google
WB_CREDENTIALS=credentials.json

# Имя листа внутри таблицы
WB_SHEET_NAME=Лист1
